# Jaipur Stonecraft Environment Configuration

# Database Configuration (MySQL)
DATABASE_URL=mysql://root:password@localhost:3306/jaipur_stonecraft

# Admin Authentication & Security
ADMIN_PASSWORD=jscadmin2026
ADMIN_SECRET_KEY=jsc-admin-secret-key-2026-atelier

# Automated Backup & Off-Site Sync Configuration
BACKUP_SECRET_KEY=jsc-backup-cron-secret-key-2026
BACKUP_RETENTION_COUNT=14

# Off-Site Google Drive Backup Sync (Service Account JWT)
# Required for automated off-site Google Drive sync. If left blank, backups fall back to local disk storage.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=backup-service@your-project-id.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_backup_folder_id_here

# Server Configuration
PORT=3000
NODE_ENV=development

# AI Content Intelligence & SEO Configuration (Server-Side Only)
# Dual-Mode System: Groq for fast text optimization, Gemini for multimodal vision analysis
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Remote Production Database URL (Used locally by `npm run sync:push` / `npm run sync:pull`)
# On Hostinger, allow Remote MySQL access in hPanel for your local IP, or use SSH tunnel
# PRODUCTION_DATABASE_URL=mysql://remote_user:password@your-hostinger-server-ip:3306/jsc_production_db

# Machine-to-Machine Media Synchronization Configuration (Local <-> Hostinger Production)
# MEDIA_SYNC_URL=https://lavenderblush-crab-850824.hostingersite.com
# MEDIA_SYNC_SECRET=your_admin_or_media_sync_secret_key_here



