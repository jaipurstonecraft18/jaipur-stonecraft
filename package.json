{
  "name": "jaipur-stonecraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start",
    "backup": "node --env-file=.env scripts/backup-runner.js",
    "restore": "node --env-file=.env scripts/sync-runner.mjs restore",
    "sync:status": "node --env-file=.env scripts/sync-runner.mjs status",
    "sync:verify": "node --env-file=.env scripts/sync-runner.mjs verify",
    "sync:push": "node --env-file=.env scripts/sync-runner.mjs push",
    "sync:pull": "node --env-file=.env scripts/sync-runner.mjs pull",
    "sync:prod": "node --env-file=.env scripts/sync-runner.mjs pull",
