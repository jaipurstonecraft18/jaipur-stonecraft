  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "mysql2": "^3.23.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3"
